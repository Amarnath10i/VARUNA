# VARUNA — Environment variables (copy to .env and fill in)
# NEVER commit .env to git!

# --- Google Gemini API (for plain-language risk briefs) ---
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Copernicus Data Space Ecosystem (for Sentinel-NRT live tiles) ---
# Register at: https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=your_cdse_client_id
CDSE_CLIENT_SECRET=your_cdse_client_secret

# --- Copernicus Climate Data Store (for ERA5 reanalysis download) ---
# Create ~/.cdsapirc with your CDS key (UID:API_KEY)
# CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
# CDS_API_KEY=your_uid:your_api_key

# --- Optional: Weights & Biases for experiment tracking ---
# WANDB_API_KEY=your_wandb_key
# WANDB_PROJECT=varuna

# --- Data directory (defaults to ./data/raw) ---
# VARUNA_DATA_DIR=/path/to/data